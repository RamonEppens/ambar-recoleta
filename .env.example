# Copiá este archivo como .env.local y completá los valores (nunca subas .env.local a git).
# Supabase → Project Settings → API Keys.

# Públicas (prefijo NEXT_PUBLIC_: llegan al navegador; RLS protege los datos).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Secreta (SIN prefijo: queda solo en el servidor). Saltea RLS: nunca al navegador ni a git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Mercado Pago (Checkout Pro). Secretas: solo en el servidor.
# Access Token de la cuenta de prueba VENDEDORA (credenciales de producción de esa cuenta).
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
# Clave secreta del webhook (Tus integraciones → Webhooks): valida la firma de cada aviso.
MP_WEBHOOK_SECRET=xxxxxxxxxxxx
# URL pública del sitio, para las back_urls. En local se usa la del pedido (http://localhost:3000).
# SITIO_URL=https://ambar-recoleta.vercel.app

# Indexación en buscadores: solo "true" cuando Ámbar apruebe el sitio.
# ALLOW_INDEXING=true
