# Copiá este archivo como .env.local y completá los valores (nunca subas .env.local a git).
# Supabase → Project Settings → API Keys.

# Públicas (prefijo NEXT_PUBLIC_: llegan al navegador; RLS protege los datos).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Secreta (SIN prefijo: queda solo en el servidor). Saltea RLS: nunca al navegador ni a git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# Indexación en buscadores: solo "true" cuando Ámbar apruebe el sitio.
# ALLOW_INDEXING=true
